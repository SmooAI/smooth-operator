# Shared provider setup for the docker-compose examples (web-chat + tui-chat).
#
#   cp examples/.env.example examples/.env   # then edit the two values below
#
# Both example stacks read this file. The ONLY thing you must set is your LLM
# gateway key. Everything else (Postgres, bind, seeded knowledge, HITL) is wired
# for you in each docker-compose.yml.

# ── Your LLM gateway (BYO, OpenAI-compatible /v1) ────────────────────────────
# The server talks to any OpenAI-compatible chat+embeddings endpoint. Pick one:
#
#   Smoo AI gateway (default):  SMOOAI_GATEWAY_URL=https://llm.smoo.ai/v1
#   OpenAI:                     SMOOAI_GATEWAY_URL=https://api.openai.com/v1
#   Groq:                       SMOOAI_GATEWAY_URL=https://api.groq.com/openai/v1
#   Local (Ollama/LM Studio):   SMOOAI_GATEWAY_URL=http://host.docker.internal:11434/v1
#
SMOOAI_GATEWAY_URL=https://llm.smoo.ai/v1

# Required for real replies AND for semantic knowledge retrieval (embeddings run
# through the same gateway). Without it the server still boots and the UI still
# connects, but send_message returns a clean error and retrieval falls back to a
# non-semantic hash embedder.
SMOOAI_GATEWAY_KEY=

# Chat model to run. Must be a model your gateway above exposes.
#   Smoo AI:  claude-haiku-4-5 (default) · deepseek-v4-flash
#   OpenAI:   gpt-4o-mini
#   Groq:     llama-3.3-70b-versatile
SMOOTH_AGENT_MODEL=gemini-2.5-flash
